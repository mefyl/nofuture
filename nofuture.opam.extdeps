opam-version: "2.0"
name: "nofuture"
version: "0.0.1"
synopsis: "Agnostic parallel IO interface"
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/nofuture"
bug-reports: "https://gitlab.routine.co/routine/nofuture/-/issues"
depends: [
  "ocamlformat" {= "0.26.1"}
  "opam-file-format"
  "sexplib"
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "dune" {= "3.12.1"}
  "ocaml" {= "5.1.1"}
  "ocaml-base-compiler" {= "5.1.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
]
dev-repo: "git+https://gitlab.routine.co/routine/nofuture.git"
