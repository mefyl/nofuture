(version 4.1.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml)))

(source
 (fetch
  (url
   https://github.com/ocurrent/ocaml-version/releases/download/v4.1.1/ocaml-version-4.1.1.tbz)
  (checksum
   sha512=074387a4dd672294f0ac8a93cbe32c3f25e0f06d0da45f503986a22dda3bed8fd801290945e19cc6f17c7b838fab4e0a390a8cf43aa9cbc8a359a69d3e4e0d5a)))
