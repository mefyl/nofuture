  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "cppo" {= "1.6.9"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.12.1"}
  "dune-configurator" {= "3.12.1"}
  "lwt" {= "5.7.0"}
  "ocaml" {= "5.1.1"}
  "ocaml-base-compiler" {= "5.1.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.6"}
  "ocplib-endian" {= "1.2"}
]
dev-repo: "git+https://gitlab.routine.co/routine/nofuture.git"
