opam-version: "2.0"
version: "0.1.2"
synopsis: "Lwt direct style implementation of nofuture for Unix"
maintainer: ["mefyl <mefyl@gruntech.org>"]
authors: ["mefyl <mefyl@gruntech.org>"]
license: "LGPL-3.0-or-later"
homepage: "https://gitlab.routine.co/routine/nofuture"
bug-reports: "https://gitlab.routine.co/routine/nofuture/-/issues"
depends: [
  "dune" {>= "3.12"}
  "lwt-android"
  "lwt_direct"
  "nofuture-lwt-direct-android" {= version}
  "ocaml-android" {>= "5.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-x"
    "android"
    "-p"
    "nofuture-lwt-direct-unix"
    "-j"
    jobs
    "@install"
  ]
]
dev-repo: "git+https://gitlab.routine.co/routine/nofuture.git"
