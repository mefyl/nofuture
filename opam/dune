(alias
 (name default)
 (deps))

(rule
 (target nofuture.%{version:nofuture}.opam)
 (deps
  (:opam ../nofuture.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run
     git
     log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/nofuture#%H\" }"
     -n1)))))

(rule
 (target nofuture-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:../.logistic/ci/dune/dune_sak.exe}
    rewrite-ios
    --input
    %{dep:../nofuture.opam}
    --cross
    nofuture,nofuture-async,nofuture-eio,nofuture-lwt,nofuture-lwt-jsoo,nofuture-lwt-unix,base,base64,cohttp-lwt,ezjsonm,fmt,hlist,logs,lwt,ptime,sexplib,uri
    --cross-both
    bake,fmt,landmarks-ppx,ppx_deriving,ppx_hash,ppx_here,semver2
    --cross-exclude
    ""))))

